{
  "name": "temp-scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --experimental-strip-types server/start.ts",
    "reset-db": "node --experimental-strip-types server/reset-db.ts",
    "run": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run dev -- --port ${CONDUCTOR_PORT:-5173}\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "12.11.1",
    "commander": "^15.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.5",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
