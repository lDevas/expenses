  "rules": [
    {
      "id": "seed-accounting-fee",
      "name": "Reported fees",
      "categoryId": "expense-bank-fees-interest",
      "pattern": ".*",
      "accountingType": "fee",
      "enabled": true
    },
    {
      "id": "seed-accounting-tax",
      "name": "Reported taxes",
      "categoryId": "expense-taxes",
      "pattern": ".*",
      "accountingType": "tax",
      "enabled": true
    },
    {
      "id": "seed-expense-taxes",
      "name": "Taxes",
      "categoryId": "expense-taxes",
      "pattern": "(?<![A-Z])I[.\\s]*V[.\\s]*A(?:\\.|\\b)",
      "accountingType": null,
      "enabled": true
    },
    {
      "id": "seed-expense-bank-fees-interest",
      "name": "Bank fees & interest",
      "categoryId": "expense-bank-fees-interest",
      "pattern": "COMISION|CAMBIOSCOM|ENVIO ESTADO|DEBITO PAQUETE|CUOTA ANUAL|INTERESES FINANCIEROS|MULTA POR MORA|COBRO TARJETA|SEGURO.*(SALDO|SDO)",
      "accountingType": null,
      "enabled": true
    },
    {
      "id": "seed-expense-electricity",
