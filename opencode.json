{
  "$schema": "https://opencode.ai/config.json",
  "snapshots": true,
  "formatter": false,
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  },
  "warming": false,
  "mcp": {
    "timeout": {
      "startup": 30000,
      "catalog": 30000,
      "execution": 43200000
    },
    "servers": {
      "browsermcp": {
        "type": "local",
        "command": ["npx", "-y", "@browsermcp/mcp@latest"]
      }
    }
  },
  "experimental": {
    "portable_shell_scanner": false
  },
  "watcher": {
    "ignore": ["data/**", "dist/**", "coverage/**"]
  },
  "permissions": [
    { "action": "read", "resource": "data", "effect": "deny" },
    { "action": "read", "resource": "data/*", "effect": "deny" },
    { "action": "edit", "resource": "data", "effect": "deny" },
    { "action": "edit", "resource": "data/*", "effect": "deny" },
    { "action": "shell", "resource": "npm run reset-db*", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "npm run test:browser*", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" }
  ]
}
